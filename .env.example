# Copy this file to .env and fill in the values. Never commit .env.
# Commented-out lines show the default value.

# Required. Used to sign cookies and tokens: keep it secret and at least 32 characters long.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Required. PostgreSQL connection for the app, and for the tests (the name must end in _test).
# `make db-setup` creates the role and databases and fills both lines in for you.
DATABASE_URL=
TEST_DATABASE_URL=

# Where uploaded media is stored. Defaults to ./data at the repository root.
# DATA_DIR=/absolute/path/to/data

# Base URL clients use to open share links (your tunnel URL in production).
# PUBLIC_BASE_URL=http://localhost:5173

# Send cookies over HTTPS only. Browsers treat http://localhost as secure, so this can stay on in development.
# COOKIE_SECURE=true

# Days a sign-in lasts before you have to log in again.
# SESSION_DAYS=7

# Largest accepted upload, in megabytes.
# MAX_UPLOAD_MB=1024

# Days to keep access-log entries before they're deleted automatically.
# LOG_RETENTION_DAYS=90
